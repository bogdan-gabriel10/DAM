<?xml version="1.0" encoding="utf-8"?>


<LinearLayout android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:layout_editor_absoluteX="1dp"
    tools:layout_editor_absoluteY="1dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <EditText
        android:id="@+id/tiltu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/titluCarte" />

    <TextView
        android:id="@+id/gen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Genul cartii" />

    <Spinner
        android:id="@+id/tipCarte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/tip"/>

    <EditText
        android:id="@+id/anPublicare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number"
        android:hint="@string/anPublicare" />

    <Button
        android:id="@+id/buttonSaveBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvati cartea" />
</LinearLayout>
